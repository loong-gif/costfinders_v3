# Supabase — project "costfinder" (kdlpkjzcnbkjcvwsvlwn)
# Get credentials from: https://supabase.com/dashboard/project/kdlpkjzcnbkjcvwsvlwn/settings/api
# Schema: src/types/supabase.generated.ts (generated, never hand-edited) and supabase/schema-snapshot.json
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Transactional email (Resend). Without this, email flows fail loudly rather than
# silently reporting success. The sending domain must be verified in Resend —
# costfinders.ai is verified; costfinders.com is NOT.
RESEND_API_KEY=re_your_key
RESEND_FROM_ADDRESS=CostFinders <notifications@costfinders.ai>
CLAIM_NOTIFICATION_EMAIL=leads@costfinders.ai

# Where "add / correct my listing" submissions are emailed
# (src/app/business/listing-request/actions.ts). Optional: falls back to
# CLAIM_NOTIFICATION_EMAIL, then to support@costfinders.ai. Set it only to route listing
# requests somewhere other than the claim inbox.
# LISTING_REQUEST_EMAIL=support@costfinders.ai

# Shared secret for the detailed /api/health body. Optional, and unset is the normal state:
# without it the endpoint returns `status` and `timestamp` only, which is all an uptime
# monitor needs to decide red or green. Set it, then send it as the `x-health-token` request
# header, to also get the per-check breakdown, the failing table/RPC names and latency —
# detail that would otherwise hand live Supabase error strings to anonymous callers.
# HEALTH_CHECK_TOKEN=a-long-random-string

# Canonical site URL, used for sitemap/canonical tags and email links.
# NEXT_PUBLIC_SITE_URL is where auth + transactional email links send people, so it
# must be the domain users actually visit AND be on the Supabase Auth "Redirect URLs"
# allowlist (Dashboard > Authentication > URL Configuration), or Supabase silently
# falls back to its Site URL.
NEXT_PUBLIC_BASE_URL=https://www.costfinders.ai
NEXT_PUBLIC_SITE_URL=https://costfindersv2.vercel.app

# Error alerting (issue #21). Optional: unset is a supported state and the app no-ops
# silently, which is what local dev and preview deploys run with.
#
# Point this at a Slack or Discord incoming webhook (the payload sends a `text` field, so
# both render it as-is) or any endpoint that accepts JSON. Every logger.error() call and
# every unhandled server-side App Router error POSTs here, rate-limited to 20 distinct
# errors per 5 minutes per instance so an outage cannot flood the channel into being muted.
#
# Only an allowlist of fields is forwarded — action, code, route, digest, routeType,
# duration — never the full log context, which carries user ids and email recipients.
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Resend webhooks (docs/OPERATIONS.md, "Bounce and inbound webhooks"). The OWNER sets all
# three in Vercel for Production. Unset, each route answers 503 naming its variable.
#
# Signing secret of the Resend webhook that points at /api/webhooks/resend (events
# email.bounced + email.complained). Resend shows it once, as whsec_..., when the webhook is
# created: resend.com/webhooks -> the webhook -> Signing secret. Hard bounces and complaints
# then go through logger.error, so they reach ALERT_WEBHOOK_URL.
# RESEND_WEBHOOK_SECRET=whsec_...
#
# Signing secret of the SECOND Resend webhook, the one that points at
# /api/webhooks/resend-inbound (event email.received). Each Resend webhook has its own secret,
# so this cannot share the one above. Reading the received body also needs RESEND_API_KEY to
# be a full-access key: a sending-only key answers 401 restricted_api_key.
# RESEND_INBOUND_WEBHOOK_SECRET=whsec_...
#
# The monitored mailbox that mail to leads@ and support@costfinders.ai is forwarded to. It
# must be OFF costfinders.ai (the route refuses an own-domain address, since that would loop).
# Unset, inbound mail is logged as a warning and stays unread in Resend.
# SUPPORT_FORWARD_EMAIL=someone@a-mailbox-you-read.com

# Scheduled jobs (vercel.json `crons`; docs/OPERATIONS.md, "Scheduled gates"). The OWNER sets
# both in Vercel for Production.
#
# Any long random string (`openssl rand -hex 32`). Vercel sends it as `Authorization: Bearer ...`
# on every cron call once it is set. Unset, /api/cron/gates stays callable (rate-limited) and
# /api/cron/rebuild answers 503, because a build trigger must never be public.
# CRON_SECRET=a-long-random-string
#
# The Deploy Hook the nightly /api/cron/rebuild POSTs to, so deals ingested overnight get pages.
# It used to be a GitHub Actions secret, and GitHub never shows a secret's value again, so take
# the URL from Vercel instead: costfinders_v2 -> Settings -> Git -> Deploy Hooks lists the
# existing `nightly-rebuild` hook (branch main), or create a new one there. Unset, the route logs
# a warning naming this variable and answers 503.
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_.../...
