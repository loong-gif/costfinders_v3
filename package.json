{
  "name": "costfinders",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "generate:guides": "tsx scripts/generate-guides.ts",
    "test": "tsx --test $(find src tests -name '*.test.ts')",
    "schema:check": "tsx scripts/check-schema-drift.ts",
    "schema:snapshot": "tsx scripts/check-schema-drift.ts --write",
    "prices:check": "tsx scripts/check-price-basis.ts",
    "prices:baseline": "tsx scripts/check-price-basis.ts --write",
    "gate": "sh scripts/gate.sh",
    "test:smoke": "k6 run tests/load/smoke.js",
    "test:load": "k6 run tests/load/average.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.9",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "schema-dts": "^1.1.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@biomejs/biome": "^2.3.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "ultracite": "^7.0.10"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.4"
  }
}
