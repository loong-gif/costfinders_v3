{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/vault_sync_check.py\"",
            "timeout": 15,
            "statusMessage": "Checking the Obsidian vault was updated before push"
          }
        ]
      }
    ]
  }
}
